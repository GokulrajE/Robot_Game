extends SceneTree
func _initialize() -> void:
	call_deferred("run_tests")
func run_tests() -> void:
	var game = load("res://games/adventure/scenes/adventure.tscn").instantiate()
	root.add_child(game)
	game.set_process(false)
	for sound in game.find_children("*Sound", "AudioStreamPlayer", true, false): sound.stream = null
	assert(game.player is Node3D)
	assert(game.player.find_children("*", "MeshInstance3D", true, false).size() >= 10)
	assert(game.player.find_children("*", "Sprite2D", true, false).is_empty())
	game.start_session()
	game.player.face(Vector3.RIGHT)
	assert(game.player.get_node("AnimationPlayer").current_animation == "walk")
	game.player.face(Vector3.ZERO)
	assert(game.player.get_node("AnimationPlayer").current_animation == "idle")
	assert(game.set_mouse_target(game.get_viewport().get_camera_3d().unproject_position(Vector3(11, 0, 0))))
	game.move_player(100.0)
	assert(is_equal_approx(game.player.position.x, 11.0))
	game.reset_input()
	assert(game.set_mouse_target(game.get_viewport().get_camera_3d().unproject_position(Vector3(11, 0, -5.6))))
	game.move_player(100.0)
	assert(is_equal_approx(game.player.position.z, -5.6))
	game.toggle_pause()
	assert(not game.player.get_node("AnimationPlayer").is_playing())
	for enemy in game.enemies:
		assert(enemy is Node3D)
		assert(not enemy.get_node("AnimationPlayer").is_playing())
	game.toggle_pause()
	assert(game.player.get_node("AnimationPlayer").is_playing())
	game.player.set_protected(true)
	assert(game.player.get_node("Shield").visible)
	var quality = game.get_node("Setup/Display/Quality")
	quality.item_selected.emit(2)
	assert(root.msaa_3d == Viewport.MSAA_4X)
	quality.item_selected.emit(0)
	assert(root.msaa_3d == Viewport.MSAA_DISABLED)
	quality.item_selected.emit(1)
	assert(root.msaa_3d == Viewport.MSAA_2X)
	assert(ProjectSettings.get_setting("display/window/size/viewport_width") == 1920)
	assert(ProjectSettings.get_setting("display/window/size/viewport_height") == 1080)
	assert(ProjectSettings.get_setting("rendering/scaling_3d/scale") == 1.0)
	game.queue_free()
	await process_frame
	print("PASS: true 3D meshes, walk/idle transitions, XZ movement bounds, pause animations, shield, graphics presets and native display settings")
	quit()
